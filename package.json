{
  "name": "uptimevault",
  "version": "1.0.6",
  "description": "An offline network uptime monitor develop by Woliul Hasan.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "monitor",
    "temperature",
    "alert"
  ],
  "author": "Woliul",
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.2.1"
  },
  "build": {
    "appId": "com.woliul.uptimevault",
    "productName": "UptimeVault",
    "icon": "./assets/network.png",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "main.js",
      "index.html",
      "assets/**/*",
      "sql/sql-wasm.wasm",
      "sql/",
      "css/",
      "js/",
      "node_modules/electron/dist/ffmpeg.dll"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "woliul",
        "repo": "uptimevault"
      }
    ]
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "sql.js": "^1.13.0"
  }
}
