{
  "name": "uptimevault",
  "version": "1.0.6",
  "description": "An offline network uptime monitor develop by Woliul Hasan.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "monitor",
    "temperature",
    "alert"
  ],
  "author": "Woliul",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.woliul.uptimevault",
    "productName": "UptimeVault",
    "icon": "./assets/network.png",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "sql/sql-wasm.wasm",
      "sql/"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "woliul",
        "repo": "uptimevault"
      }
    ]
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.13.0"
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
